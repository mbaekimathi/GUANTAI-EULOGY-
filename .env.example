DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production (cPanel): https://guantai.projectlucas.co.ke
# ALLOWED_HOSTS=guantai.projectlucas.co.ke
# CSRF_TRUSTED_ORIGINS=https://guantai.projectlucas.co.ke
# DJANGO_DEBUG=False

# Set USE_SQLITE=True for local dev without MySQL (not for high concurrent traffic)
USE_SQLITE=False

# Shared file cache + sessions (created automatically under var/cache)
# CACHE_DIR=/path/to/writable/cache
# DB_CONN_MAX_AGE=600
# Default: signed cookie sessions (no DB per visitor). For large dashboard sessions:
# SESSION_ENGINE=django.contrib.sessions.backends.cached_db
# PUBLIC_CACHE_SECONDS=600
# CACHE_TIMEOUT=600
# HEALTH_CACHE_SECONDS=5
# WHITENOISE_MAX_AGE=2592000
# SQLITE_TIMEOUT=30

DB_NAME=guantai_memorial
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Memorial admin dashboard (optional overrides)
MEMORIAL_ADMIN_USERNAME=987654321
MEMORIAL_ADMIN_PASSWORD=123456789
